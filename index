<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Pyramide de Maslow interactive</title>
<style>
body {
  font-family: Arial;
  text-align: center;
}

.pyramid {
  width: 300px;
  margin: 50px auto;
}

.level {
  padding: 20px;
  color: white;
  cursor: pointer;
}

.level1 { background: #4CAF50; }
.level2 { background: #66BB6A; }
.level3 { background: #81C784; }
.level4 { background: #A5D6A7; }
.level5 { background: #C8E6C9; color: black; }

.modal {
  display: none;
  position: fixed;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  background: white;
  padding: 20px;
  border: 1px solid #ccc;
}
</style>
</head>

<body>

<h2>Pyramide de Maslow interactive</h2>

<div class="pyramid">
  <div class="level level5" onclick="showInfo(5)">Accomplissement</div>
  <div class="level level4" onclick="showInfo(4)">Estime</div>
  <div class="level level3" onclick="showInfo(3)">Appartenance</div>
  <div class="level level2" onclick="showInfo(2)">Sécurité</div>
  <div class="level level1" onclick="showInfo(1)">Besoins physiologiques</div>
</div>

<div id="modal" class="modal"></div>

<script>
function showInfo(level) {
  const modal = document.getElementById("modal");
  
  const texts = {
    1: "Besoins physiologiques : manger, dormir, respirer...",
    2: "Sécurité : logement, stabilité, protection...",
    3: "Appartenance : relations, amour, groupe...",
    4: "Estime : reconnaissance, confiance en soi...",
    5: "Accomplissement : réalisation personnelle..."
  };

  modal.innerHTML = texts[level] + "<br><br><button onclick='closeModal()'>Fermer</button>";
  modal.style.display = "block";
}

function closeModal() {
  document.getElementById("modal").style.display = "none";
}
</script>

</body>
</html>
